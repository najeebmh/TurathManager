# انسخ هذا الملف إلى .env وعدّل القيم. لا ترفع ملف .env إلى Git.
APP_NAME="Turath Manager"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/TurathManager
# مفتاح تشفير الأسرار المخزنة (32 بايت base64). أنشئه بالأمر: php scripts/generate-key.php
APP_KEY=
APP_TIMEZONE=Asia/Aden
DEFAULT_COUNTRY_CODE=967
TOKEN_TTL_HOURS=720
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost,capacitor://localhost,tauri://localhost,http://tauri.localhost,https://tauri.localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=turath_manager
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=

UPLOAD_MAX_BYTES=5242880

# WhatsApp Business Cloud API (اختياري - يمكن إدخالها أيضاً من لوحة التحكم وتُخزن مشفرة)
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Firebase Cloud Messaging HTTP v1 (اختياري)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
